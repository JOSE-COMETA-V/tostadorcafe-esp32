/**
 * @brief Envía una respuesta HTTP en formato JSON.
 */
static esp_err_t reply_json(httpd_req_t *req, const char *status, const char *json) {
    httpd_resp_set_status(req, status);
    httpd_resp_set_type(req, "application/json");
    return httpd_resp_send(req, json, HTTPD_RESP_USE_STRLEN);
}

/**
 * @brief Envía una respuesta HTTP de error en formato JSON.
 */
static esp_err_t reply_error(httpd_req_t *req, const char *status, const char *msg) {
    char out[192];
    snprintf(out, sizeof(out), "{\"ok\":false,\"msg\":\"%s\"}", msg);
    return reply_json(req, status, out);
}

/**
 * @brief Manejador de la petición GET a la raíz (`/`). Servidor de la página Web.
 */
static esp_err_t root_get_handler(httpd_req_t *req) {
    httpd_resp_set_type(req, "text/html");
    return httpd_resp_send(req, html_page, HTTPD_RESP_USE_STRLEN);
}

/**
 * @brief Manejador de la API `/api/status`. Proporciona el estado actual del sistema en JSON.
 */
static esp_err_t status_get_handler(httpd_req_t *req) {
    char json_response[512];
    char rtc_buf[20];

    get_datetime(rtc_buf, sizeof(rtc_buf));

    xSemaphoreTake(g_state_mutex, portMAX_DELAY);

    hum_class_t hc = classify_humidity(g_humidity_dht);
    const char *hum_state_str = hum_class_text(hc);

    float auto_t = 0.0f;
    uint32_t auto_s = 0;
    if (g_dht_valid_once) {
        auto_params_for(hc, &auto_t, &auto_s);
    }

    const char *state_str = "IDLE";
    if (g_roast_state == ROAST_RUNNING) state_str = "RUNNING";
    else if (g_roast_state == ROAST_DONE) state_str = "DONE";

    const char *mode_str = "NONE";
    if (g_roast_mode == ROAST_MODE_MANUAL) mode_str = "MANUAL";
    else if (g_roast_mode == ROAST_MODE_AUTO) mode_str = "AUTO";

    const char *phase_str = "-";
    if (g_roast_state == ROAST_RUNNING) {
        if (g_max_error) phase_str = "ERROR SENSOR";
        else if (!g_setpoint_reached) phase_str = "CALENTANDO";
        else phase_str = "MANTENIENDO";
    }

    snprintf(json_response, sizeof(json_response),
             "{\"temp_max\":%.2f,\"max_err\":%s,\"humidity\":%.1f,\"dht_err\":%s,\"hum_state\":\"%s\","
             "\"state\":\"%s\",\"mode\":\"%s\",\"phase\":\"%s\",\"setpoint\":%.1f,"
             "\"total_s\":%lu,\"remaining_s\":%lu,\"auto_temp\":%.1f,\"auto_min\":%.1f,\"rtc_time\":\"%s\"}",
             g_temp_max, g_max_error ? "true" : "false",
             g_humidity_dht, g_dht_error ? "true" : "false",
             hum_state_str,
             state_str, mode_str, phase_str, g_setpoint,
             (unsigned long)g_total_s, (unsigned long)g_remaining_s,
             auto_t, (float)auto_s / 60.0f,
             rtc_buf);
    xSemaphoreGive(g_state_mutex);

    httpd_resp_set_type(req, "application/json");
    return httpd_resp_send(req, json_response, HTTPD_RESP_USE_STRLEN);
}

/**
 * @brief Manejador de la API `/api/start`. Inicia el proceso de tostado (Manual o Automático).
 */
static esp_err_t start_handler(httpd_req_t *req) {
    char buf[96] = {0};
    char mode_str[12] = {0}, temp_str[16] = {0}, time_str[16] = {0};

    if (httpd_req_get_url_query_str(req, buf, sizeof(buf)) != ESP_OK ||
        httpd_query_key_value(buf, "mode", mode_str, sizeof(mode_str)) != ESP_OK) {
        return reply_error(req, "400 Bad Request", "Solicitud inválida");
    }

    roast_mode_t mode;
    float temp_c = 0.0f;
    uint32_t secs = 0;

    if (strcmp(mode_str, "manual") == 0) {
        mode = ROAST_MODE_MANUAL;
        if (httpd_query_key_value(buf, "temp", temp_str, sizeof(temp_str)) != ESP_OK ||
            httpd_query_key_value(buf, "time", time_str, sizeof(time_str)) != ESP_OK) {
            return reply_error(req, "400 Bad Request", "Faltan la temperatura o el tiempo");
        }
        temp_c = strtof(temp_str, NULL);
        long t = strtol(time_str, NULL, 10);
        if (temp_c < ROAST_TEMP_MIN_C || temp_c > ROAST_TEMP_MAX_C) {
            return reply_error(req, "400 Bad Request", "Temperatura fuera de rango (30 a 250 °C)");
        }
        if (t < ROAST_TIME_MIN_S || t > ROAST_TIME_MAX_S) {
            return reply_error(req, "400 Bad Request", "Tiempo fuera de rango (10 s a 120 min)");
        }
        secs = (uint32_t)t;
    } else if (strcmp(mode_str, "auto") == 0) {
        mode = ROAST_MODE_AUTO;
    } else {
        return reply_error(req, "400 Bad Request", "Modo desconocido");
    }

    const char *err = NULL;

    char start_dt[20];
    get_datetime(start_dt, sizeof(start_dt));

    sd_log_entry_t ev = {0};
    bool session_started = false;

    xSemaphoreTake(g_state_mutex, portMAX_DELAY);
    if (g_roast_state == ROAST_RUNNING) {
        err = "Ya hay un proceso en marcha";
    } else if (g_max_error) {
        err = "Error en la termocupla MAX6675, no se puede iniciar";
    } else if (mode == ROAST_MODE_AUTO && !g_dht_valid_once) {
        err = "Aún no hay lectura válida de humedad";
    } else {
        if (mode == ROAST_MODE_AUTO) {
            auto_params_for(classify_humidity(g_humidity_dht), &temp_c, &secs);
        }
        g_roast_mode = mode;
        g_setpoint = temp_c;
        g_total_s = secs;
        g_remaining_s = secs;
        g_setpoint_reached = false;
        g_session_id++;
        g_roast_state = ROAST_RUNNING;

        set_outputs_locked(true, true);

        ev.type = LOG_SESSION_START;
        ev.session_id = g_session_id;
        strlcpy(ev.datetime, start_dt, sizeof(ev.datetime));
        ev.humidity = g_dht_valid_once ? g_humidity_dht : -1.0f;
        ev.mode = mode;
        ev.setpoint = temp_c;
        ev.total_s = secs;
        session_started = true;
    }
    xSemaphoreGive(g_state_mutex);

    if (err) {
        return reply_error(req, "409 Conflict", err);
    }

    if (sd_ok && session_started) {
        if (xQueueSend(xQueueSD, &ev, pdMS_TO_TICKS(100)) != pdTRUE) {
            ESP_LOGW(TAG, "Cola SD llena: no se registró el inicio de la sesión %lu",
                     (unsigned long)ev.session_id);
        }
    }

    ESP_LOGI(TAG, "Tostado iniciado (sesión %lu): %s, %.1f C, %lu s",
             (unsigned long)ev.session_id,
             (mode == ROAST_MODE_AUTO) ? "AUTO" : "MANUAL", temp_c, (unsigned long)secs);
    return reply_json(req, "200 OK", "{\"ok\":true}");
}

/**
 * @brief Manejador de la API `/api/stop`. Detiene inmediatamente el tostado activo.
 */
static esp_err_t stop_handler(httpd_req_t *req) {
    xSemaphoreTake(g_state_mutex, portMAX_DELAY);
    set_outputs_locked(false, false);
    g_roast_state = ROAST_IDLE;
    g_roast_mode = ROAST_MODE_NONE;
    g_remaining_s = 0;
    g_setpoint_reached = false;
    xSemaphoreGive(g_state_mutex);

    ESP_LOGI(TAG, "Tostado detenido por el usuario.");
    return reply_json(req, "200 OK", "{\"ok\":true}");
}

/**
 * @brief Inicializa el servidor Web HTTP de ESP-IDF y registra los puntos de acceso API.
 * 
 * @return httpd_handle_t Manejador de la instancia del servidor HTTP.
 */
httpd_handle_t start_webserver(void) {
    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
    config.stack_size = 8192;
    httpd_handle_t server = NULL;

    if (httpd_start(&server, &config) == ESP_OK) {
        httpd_uri_t uri_root = { .uri = "/", .method = HTTP_GET, .handler = root_get_handler };
        httpd_uri_t uri_status = { .uri = "/api/status", .method = HTTP_GET, .handler = status_get_handler };
        httpd_uri_t uri_start = { .uri = "/api/start", .method = HTTP_GET, .handler = start_handler };
        httpd_uri_t uri_stop = { .uri = "/api/stop", .method = HTTP_GET, .handler = stop_handler };

        httpd_register_uri_handler(server, &uri_root);
        httpd_register_uri_handler(server, &uri_status);
        httpd_register_uri_handler(server, &uri_start);
        httpd_register_uri_handler(server, &uri_stop);
    }
    return server;
}

/**
 * @brief Controlador de eventos para el subsistema Wi-Fi e IP.
 */
static void wifi_event_handler(void* arg, esp_event_base_t event_base, int32_t event_id, void* event_data) {
    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
        esp_wifi_connect();
    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
        esp_wifi_connect();
    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
        ip_event_got_ip_t* event = (ip_event_got_ip_t*) event_data;
        ESP_LOGI(TAG, "Conectado a Wi-Fi. Ingresa a: http://" IPSTR, IP2STR(&event->ip_info.ip));
    }
}

/**
 * @brief Inicializa la interfaz de red Wi-Fi en modo Estación (STA).
 */
void wifi_init_sta(void) {
    ESP_ERROR_CHECK(esp_netif_init());
    ESP_ERROR_CHECK(esp_event_loop_create_default());
    esp_netif_create_default_wifi_sta();
    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, NULL);
    esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, NULL);

    wifi_config_t wifi_config = {
        .sta = {
            .ssid = WIFI_SSID,
            .password = WIFI_PASS,
            .threshold.authmode = WIFI_AUTH_WPA2_PSK,
        },
    };
    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
    ESP_ERROR_CHECK(esp_wifi_start());
}

/* =======================================================================
 * TAREAS FREERTOS
 * ======================================================================= */

/**
 * @brief Tarea FreeRTOS para la lectura periódica (1 Hz) del RTC DS3231.
 */
static void vTaskRTC(void *pv) {
    struct tm t;
    char buf[20];
    while (1) {
        if (ds3231_get_time(&t) == ESP_OK) {
            strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &t);
            xSemaphoreTake(xTimeMutex, portMAX_DELAY);
            strlcpy(shared_datetime, buf, sizeof(shared_datetime));
            xSemaphoreGive(xTimeMutex);
        }
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

#if MOTOR_PULSE_ENABLE
/**
 * @brief Tarea FreeRTOS para la modulación por ancho de pulso del relé del motor.
 */
static void vTaskMotorPulse(void *pv) {
    TickType_t last_wake = xTaskGetTickCount();
    uint32_t phase_ms = 0;
    bool prev_enabled = false;

    while (1) {
        xSemaphoreTake(g_state_mutex, portMAX_DELAY);
        bool enabled = g_motor_state;

        if (!enabled) {
            gpio_set_level(MOTOR_RELAY_PIN, 0);
            phase_ms = 0;
        } else {
            if (!prev_enabled) {
                phase_ms = 0;
            }
            gpio_set_level(MOTOR_RELAY_PIN, (phase_ms < MOTOR_PULSE_ON_MS) ? 1 : 0);
            phase_ms = (phase_ms + MOTOR_PULSE_STEP_MS) % MOTOR_PULSE_PERIOD_MS;
        }
        xSemaphoreGive(g_state_mutex);

        prev_enabled = enabled;
        vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(MOTOR_PULSE_STEP_MS));
    }
}
#endif

/**
 * @brief Tarea FreeRTOS principal de lectura de sensores y bucle de control térmico.
 */
static void vTaskSensorAndControl(void *pv) {
    vTaskDelay(pdMS_TO_TICKS(1000));
    TickType_t last_wake = xTaskGetTickCount();
    uint8_t  loop_counter = 0;
    uint8_t  sd_sample_tick = 0;
    uint32_t last_logged_session = 0;

    while (1) {
        float temp_max = 0.0f;
        uint8_t max_st = 0;

        float hum_dht = 0.0f;
        uint8_t dht_st = 0;

        /* 1. Lectura MAX6675 */
        max6675_read(&temp_max, &max_st);

        /* 2. Lectura DHT11 */
        esp_err_t dht_res = dht11_read_humidity(DHT11_PIN, &hum_dht);

        xSemaphoreTake(g_state_mutex, portMAX_DELAY);

        g_max_error = (max_st != 0);
        if (!g_max_error) {
            g_temp_max = temp_max;
        }

        if (dht_res == ESP_OK) {
            g_humidity_dht = hum_dht;
            g_dht_valid_once = true;
            g_dht_error = false;
            dht_st = 0;
        } else {
            g_dht_error = !g_dht_valid_once;
            dht_st = 1;
        }

        bool     log_active  = (g_roast_state == ROAST_RUNNING);
        uint32_t log_session = g_session_id;

        /* 3. Control del proceso de tostado */
        if (g_roast_state == ROAST_RUNNING) {
            bool heater = g_heater_state;

            if (g_max_error) {
                heater = false;
            } else {
                if (g_temp_max >= g_setpoint) {
                    g_setpoint_reached = true;
                }
                if (g_temp_max >= g_setpoint + ROAST_HYSTERESIS_C) {
                    heater = false;
                } else if (g_temp_max <= g_setpoint - ROAST_HYSTERESIS_C) {
                    heater = true;
                }
            }
            set_outputs_locked(true, heater);

            bool count_time = (!ROAST_TIMER_FROM_SETPOINT) || g_setpoint_reached;
            if (count_time && g_remaining_s > 0) {
                g_remaining_s--;
            }
            if (g_remaining_s == 0) {
                set_outputs_locked(false, false);
                g_roast_state = ROAST_DONE;
                ESP_LOGI(TAG, "Tostado finalizado.");
            }
        }

        float current_hum = g_humidity_dht;
        xSemaphoreGive(g_state_mutex);

        /* 4a. Transmisión por puerto serie (Cada 5 segundos) */
        loop_counter++;
        if (loop_counter >= 5) {
            loop_counter = 0;

            datalog_entry_t s = {0};
            s.timestamp_ms = esp_timer_get_time() / 1000;
            get_datetime(s.datetime, sizeof(s.datetime));

            s.temp_max6675 = temp_max;
            s.max_status = max_st;
            s.humidity_dht = current_hum;
            s.dht_status = dht_st;

            xQueueSend(xQueueSerial, &s, pdMS_TO_TICKS(50));
        }

        /* 4b. Guardado en Tarjeta SD */
        if (sd_ok && log_active) {
            if (log_session != last_logged_session) {
                last_logged_session = log_session;
                sd_sample_tick = 0;
            }
            if (sd_sample_tick == 0) {
                sd_log_entry_t e = {0};
                e.type = LOG_TEMP_SAMPLE;
                e.session_id = log_session;
                get_datetime(e.datetime, sizeof(e.datetime));
                e.temp = temp_max;
                e.max_status = max_st;
                xQueueSend(xQueueSD, &e, pdMS_TO_TICKS(50));
            }
            sd_sample_tick = (sd_sample_tick + 1) % SD_SAMPLE_PERIOD_S;
        }

        vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(1000));
    }
}

/**
 * @brief Tarea FreeRTOS para la gestión de los indicadores luminosos y sonoros.
 */
static void vTaskIndicators(void *pv) {
    const uint32_t half_ticks = BUZZER_HALF_PERIOD_MS / INDICATOR_TASK_PERIOD_MS;
    uint32_t tick = 0;

    while (1) {
        xSemaphoreTake(g_state_mutex, portMAX_DELAY);
        bool running = (g_roast_state == ROAST_RUNNING);
        xSemaphoreGive(g_state_mutex);

        if (running) {
            bool buzzer_on = ((tick / half_ticks) % 2) == 0;
            tick++;

            gpio_set_level(BUZZER_PIN, buzzer_on ? 1 : 0);
            gpio_set_level(LED_ACTIVE_PIN, 1);
            gpio_set_level(LED_STOPPED_PIN, 0);
        } else {
            tick = 0;
            gpio_set_level(BUZZER_PIN, 0);
            gpio_set_level(LED_ACTIVE_PIN, 0);
            gpio_set_level(LED_STOPPED_PIN, 1);
        }

        vTaskDelay(pdMS_TO_TICKS(INDICATOR_TASK_PERIOD_MS));
    }
}

/**
 * @brief Convierte la trama de datos del puerto serie a cadena CSV.
 */
static void format_csv(const datalog_entry_t *d, char *out, size_t len) {
    snprintf(out, len, "%llu,%s,%.2f,%u,%.1f,%u",
             (unsigned long long)d->timestamp_ms, d->datetime,
             d->temp_max6675, (unsigned)d->max_status,
             d->humidity_dht, (unsigned)d->dht_status);
}

/**
 * @brief Tarea FreeRTOS encargada de la escritura física en la tarjeta SD.
 */
static void vTaskSDWriter(void *pv) {
    sd_log_entry_t e;
    char line[160];

    while (1) {
        if (xQueueReceive(xQueueSD, &e, portMAX_DELAY) == pdTRUE) {
            const char *path;
            if (e.type == LOG_SESSION_START) {
                format_session_csv(&e, line, sizeof(line));
                path = SESSIONS_FILE;
            } else {
                format_sample_csv(&e, line, sizeof(line));
                path = TEMPS_FILE;
            }

            xSemaphoreTake(xSdMutex, portMAX_DELAY);
            FILE *f = fopen(path, "a");
            if (f) {
                fprintf(f, "%s\n", line);
                fclose(f);
            } else {
                ESP_LOGE(TAG, "No se pudo abrir %s", path);
            }
            xSemaphoreGive(xSdMutex);
        }
    }
}

/**
 * @brief Tarea FreeRTOS para la salida de depuración por la consola Serie en tiempo real.
 */
static void vTaskSerial(void *pv) {
    datalog_entry_t d;
    char line[140];
    printf("timestamp_ms,datetime,temp_max6675,estado_max,humedad_dht11,estado_dht\n");
    while (1) {
        if (xQueueReceive(xQueueSerial, &d, portMAX_DELAY) == pdTRUE) {
            format_csv(&d, line, sizeof(line));
            printf("%s\n", line);
        }
    }
}

/* =======================================================================
 * PUNTO DE ENTRADA PRINCIPAL (app_main)
 * ======================================================================= */

/**
 * @brief Función de inicio del firmware ESP-IDF.
 * @details Inicializa la memoria NVS, primitivas de sincronización FreeRTOS, GPIOs,
 *          buses I2C y SPI (SD y MAX6675), VFS FAT, subsistema Wi-Fi, Servidor Web
 *          y lanza las tareas concurrentes.
 */
void app_main(void) {
    esp_log_level_set(TAG, ESP_LOG_INFO);

    /* 1. Inicialización de Memoria NVS y Mutex/Colas FreeRTOS */
    esp_err_t ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ret = nvs_flash_init();
    }
    ESP_ERROR_CHECK(ret);

    g_state_mutex = xSemaphoreCreateMutex();
    xSdMutex      = xSemaphoreCreateMutex();
    xTimeMutex    = xSemaphoreCreateMutex();
    xQueueSD      = xQueueCreate(QUEUE_LEN, sizeof(sd_log_entry_t));
    xQueueSerial  = xQueueCreate(QUEUE_LEN, sizeof(datalog_entry_t));

    /* 2. Inicialización de GPIOs (Relés, Indicadores y DHT11) */
    init_relay_gpios();
    init_indicator_gpios();
    gpio_reset_pin(DHT11_PIN);

    /* 3. Inicialización del Bus I2C (RTC DS3231) */
    i2c_config_t i2c_bus_cfg = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = I2C_SDA_PIN,
        .scl_io_num = I2C_SCL_PIN,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master.clk_speed = 100000,
    };
    ESP_ERROR_CHECK(i2c_param_config(I2C_NUM_0, &i2c_bus_cfg));
    ESP_ERROR_CHECK(i2c_driver_install(I2C_NUM_0, I2C_MODE_MASTER, 0, 0, 0));

#if SET_RTC_TIME_ON_BOOT
    struct tm init_time = {
        .tm_year = 2026 - 1900,
        .tm_mon  = 9,
        .tm_mday = 4,
        .tm_hour = 11,
        .tm_min  = 22,
        .tm_sec  = 0,
        .tm_wday = 2
    };
    ds3231_set_time(&init_time);
#endif

    /* 4. Inicialización Bus SPI 1: Tarjeta SD (SPI2_HOST) */
    spi_bus_config_t sd_bus_cfg = {
        .mosi_io_num = PIN_SD_MOSI,
        .miso_io_num = PIN_SD_MISO,
        .sclk_io_num = PIN_SD_CLK,
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = 4096,
    };
    ESP_ERROR_CHECK(spi_bus_initialize(SPI2_HOST, &sd_bus_cfg, SDSPI_DEFAULT_DMA));

    /* 5. Inicialización Bus SPI 2: Termocupla MAX6675 (SPI3_HOST) */
    spi_bus_config_t max_bus_cfg = {
        .mosi_io_num = -1,
        .miso_io_num = PIN_MAX_MISO,
        .sclk_io_num = PIN_MAX_CLK,
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = 0,
    };
    ESP_ERROR_CHECK(spi_bus_initialize(SPI3_HOST, &max_bus_cfg, SPI_DMA_DISABLED));

    spi_device_interface_config_t max_cfg = {
        .clock_speed_hz = 100 * 1000,
        .mode = 0,
        .spics_io_num = PIN_CS_MAX6675,
        .queue_size = 1,
    };
    ESP_ERROR_CHECK(spi_bus_add_device(SPI3_HOST, &max_cfg, &max6675_dev));

    /* 6. Montaje del Sistema de Archivos VFS FAT en la Tarjeta SD */
    esp_vfs_fat_sdmmc_mount_config_t mount_config = {
        .format_if_mount_failed = false,
        .max_files = 5,
        .allocation_unit_size = 16 * 1024,
    };
    sdmmc_card_t *card;
    sdmmc_host_t host = SDSPI_HOST_DEFAULT();
    host.slot = SPI2_HOST;
    host.max_freq_khz = 4000;

    sdspi_device_config_t slot_config = SDSPI_DEVICE_CONFIG_DEFAULT();
    slot_config.gpio_cs = PIN_CS_SD;
    slot_config.host_id = SPI2_HOST;

    if (esp_vfs_fat_sdspi_mount(MOUNT_POINT, &host, &slot_config, &mount_config, &card) == ESP_OK) {
        sd_ok = true;
        ESP_LOGI(TAG, "SD montada correctamente.");

        g_session_id = sd_prepare_files();
        ESP_LOGI(TAG, "Última sesión registrada en SD: %lu", (unsigned long)g_session_id);
    } else {
        ESP_LOGE(TAG, "Fallo al montar SD.");
    }

    /* 7. Arranque del Servidor Web y Tareas FreeRTOS */
    wifi_init_sta();
    start_webserver();

    xTaskCreate(vTaskRTC, "rtc_task", 3072, NULL, 3, NULL);
    xTaskCreate(vTaskSensorAndControl, "sensor_control_task", 4096, NULL, 5, NULL);
    xTaskCreate(vTaskSerial, "serial_task", 3072, NULL, 3, NULL);
    xTaskCreate(vTaskIndicators, "indicator_task", 2048, NULL, 2, NULL);

#if MOTOR_PULSE_ENABLE
    xTaskCreate(vTaskMotorPulse, "motor_pulse_task", 2048, NULL, 4, NULL);
#endif

    if (sd_ok) {
        xTaskCreate(vTaskSDWriter, "sd_task", 5120, NULL, 4, NULL);
    }
}
