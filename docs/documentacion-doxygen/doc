/* =======================================================================
 * CONFIGURACIÓN DE PINES GPIO
 * ======================================================================= */

/** @brief Pin GPIO conectado al relé del motor del barril/tambor. */
#define MOTOR_RELAY_PIN   GPIO_NUM_26
/** @brief Pin GPIO conectado al relé de la fuente de calor (calefactor). */
#define HEATER_RELAY_PIN  GPIO_NUM_25
/** @brief Máscara de bits para la configuración de GPIOs de los relés de potencia. */
#define RELAY_PIN_SEL     ((1ULL << MOTOR_RELAY_PIN) | (1ULL << HEATER_RELAY_PIN))

/** @brief Pin GPIO asignado a la línea de datos del sensor DHT11. */
#define DHT11_PIN         GPIO_NUM_32

/** @brief Pin MISO del bus SPI para la tarjeta SD (SPI2_HOST). */
#define PIN_SD_MISO       19
/** @brief Pin MOSI del bus SPI para la tarjeta SD (SPI2_HOST). */
#define PIN_SD_MOSI       23
/** @brief Pin Clock (CLK) del bus SPI para la tarjeta SD (SPI2_HOST). */
#define PIN_SD_CLK        18
/** @brief Pin Chip Select (CS) para la tarjeta SD. */
#define PIN_CS_SD         5

/** @brief Pin MISO del bus SPI para el amplificador de termocupla MAX6675 (SPI3_HOST). */
#define PIN_MAX_MISO      27
/** @brief Pin Clock (CLK) del bus SPI para el MAX6675 (SPI3_HOST). */
#define PIN_MAX_CLK       14
/** @brief Pin Chip Select (CS) para el amplificador MAX6675. */
#define PIN_CS_MAX6675    4

/** @brief Pin SDA del bus I2C (DS3231 RTC). */
#define I2C_SDA_PIN       21
/** @brief Pin SCL del bus I2C (DS3231 RTC). */
#define I2C_SCL_PIN       22
/** @brief Dirección I2C de 7 bits del reloj de tiempo real DS3231. */
#define DS3231_I2C_ADDR   0x68

/* =======================================================================
 * INDICADORES DE ESTADO
 * ======================================================================= */

/** @brief Pin GPIO conectado al Buzzer pasivo/activo. */
#define BUZZER_PIN        GPIO_NUM_33
/** @brief Pin GPIO conectado al LED indicador de proceso de tostado activo (Rojo). */
#define LED_ACTIVE_PIN    GPIO_NUM_17
/** @brief Pin GPIO conectado al LED indicador de sistema en reposo/detenido. */
#define LED_STOPPED_PIN   GPIO_NUM_16
/** @brief Máscara de bits para los GPIOs de indicadores visuales y sonoros. */
#define INDICATOR_PIN_SEL ((1ULL << BUZZER_PIN) | (1ULL << LED_ACTIVE_PIN) | (1ULL << LED_STOPPED_PIN))

/** @brief Semiperíodo de oscilación del buzzer en milisegundos (1s encendido, 1s apagado). */
#define BUZZER_HALF_PERIOD_MS     1000
/** @brief Período de refresco de la tarea de control de indicadores en ms. */
#define INDICATOR_TASK_PERIOD_MS  100

/* =======================================================================
