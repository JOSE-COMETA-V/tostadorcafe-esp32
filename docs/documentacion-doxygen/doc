/** @brief Mutex de exclusión mutua para el acceso al sistema de archivos VFS de la SD. */
static SemaphoreHandle_t xSdMutex      = NULL;
/** @brief Mutex de protección para la lectura y escritura de la fecha/hora compartida. */
static SemaphoreHandle_t xTimeMutex    = NULL;

/** @brief Cola FreeRTOS para el envío de datos a guardar en la tarjeta SD. */
static QueueHandle_t      xQueueSD      = NULL;
/** @brief Cola FreeRTOS para la transmisión de registros por puerto serie. */
static QueueHandle_t      xQueueSerial  = NULL;

/* =======================================================================
 * FUNCIONES AUXILIARES DE TIEMPO Y SENSORES
 * ======================================================================= */

/**
 * @brief Obtiene una copia segura de la fecha y hora del RTC.
 * 
 * @param[out] out Puntero al búfer de caracteres de destino.
 * @param[in]  len Tamaño máximo del búfer.
 */
static void get_datetime(char *out, size_t len) {
    xSemaphoreTake(xTimeMutex, portMAX_DELAY);
    strlcpy(out, shared_datetime, len);
    xSemaphoreGive(xTimeMutex);
}

/**
 * @brief Realiza la lectura del sensor DHT11 mediante temporización por software.
 * 
 * @param[in]  gpio Pin GPIO asignado al DHT11.
 * @param[out] humidity Puntero donde se almacenará el porcentaje de humedad calculada.
 * 
 * @return esp_err_t 
 * @retval ESP_OK Si la trama y la suma de comprobación (checksum) son correctas.
 * @retval ESP_ERR_TIMEOUT Si el sensor no responde en los tiempos requeridos.
 * @retval ESP_ERR_INVALID_CRC Si falla la verificación checksum.
 */
static esp_err_t dht11_read_humidity(gpio_num_t gpio, float *humidity) {
    uint8_t data[5] = {0};

    gpio_set_direction(gpio, GPIO_MODE_OUTPUT);
    gpio_set_level(gpio, 0);
    vTaskDelay(pdMS_TO_TICKS(20));
    gpio_set_level(gpio, 1);
    ets_delay_us(30);
    gpio_set_direction(gpio, GPIO_MODE_INPUT);

    uint16_t timeout = 0;
    while (gpio_get_level(gpio) == 1) {
        if (++timeout > 100) return ESP_ERR_TIMEOUT;
        ets_delay_us(1);
    }
    timeout = 0;
    while (gpio_get_level(gpio) == 0) {
        if (++timeout > 100) return ESP_ERR_TIMEOUT;
        ets_delay_us(1);
    }
    timeout = 0;
    while (gpio_get_level(gpio) == 1) {
        if (++timeout > 100) return ESP_ERR_TIMEOUT;
        ets_delay_us(1);
    }

    for (int i = 0; i < 40; i++) {
        timeout = 0;
        while (gpio_get_level(gpio) == 0) {
            if (++timeout > 100) return ESP_ERR_TIMEOUT;
            ets_delay_us(1);
        }

        uint32_t t_high = 0;
        while (gpio_get_level(gpio) == 1) {
            t_high++;
            ets_delay_us(1);
            if (t_high > 100) return ESP_ERR_TIMEOUT;
        }

        if (t_high > 40) {
            data[i / 8] |= (1 << (7 - (i % 8)));
        }
    }

    if (data[4] == ((data[0] + data[1] + data[2] + data[3]) & 0xFF)) {
        *humidity = (float)data[0] + (float)data[1] * 0.1f;
        return ESP_OK;
    }

    return ESP_ERR_INVALID_CRC;
}

/* =======================================================================
 * CONTROL DE HARDWARE Y PERIFÉRICOS
 * ======================================================================= */

/**
 * @brief Configura e inicializa los pines GPIO asignados a los relés de potencia.
 */
void init_relay_gpios(void) {
    gpio_config_t io_conf = {
        .pin_bit_mask = RELAY_PIN_SEL,
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_ENABLE,
        .intr_type = GPIO_INTR_DISABLE
    };
    gpio_config(&io_conf);
    gpio_set_level(MOTOR_RELAY_PIN, 0);
    gpio_set_level(HEATER_RELAY_PIN, 0);
}

/**
 * @brief Inicializa los pines GPIO encargados de la señalización (Buzzer y LEDs).
 */
void init_indicator_gpios(void) {
    gpio_config_t io_conf = {
        .pin_bit_mask = INDICATOR_PIN_SEL,
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE
    };
    gpio_config(&io_conf);

    gpio_set_level(BUZZER_PIN, 0);
    gpio_set_level(LED_ACTIVE_PIN, 0);
    gpio_set_level(LED_STOPPED_PIN, 1);
}

/**
 * @brief Establece el estado lógico de los relés de salida.
 * @note Esta función debe invocarse previa adquisición de `g_state_mutex`.
 * 
 * @param[in] motor Estado deseado para el motor (true = activo).
 * @param[in] heater Estado deseado para el calefactor (true = activo).
 */
static void set_outputs_locked(bool motor, bool heater) {
    g_motor_state = motor;
    g_heater_state = heater;
#if MOTOR_PULSE_ENABLE
    if (!motor) {
        gpio_set_level(MOTOR_RELAY_PIN, 0);
    }
#else
    gpio_set_level(MOTOR_RELAY_PIN, motor ? 1 : 0);
#endif
    gpio_set_level(HEATER_RELAY_PIN, heater ? 1 : 0);
}

/**
 * @brief Convierte un byte en formato BCD a Decimal.
 */
static inline uint8_t bcd2dec(uint8_t v) { return ((v >> 4) * 10) + (v & 0x0F); }

/**
 * @brief Convierte un byte en formato Decimal a BCD.
 */
static inline uint8_t dec2bcd(uint8_t v) { return ((v / 10) << 4) | (v % 10); }

/**
 * @brief Programa la hora actual en el módulo RTC DS3231 vía I2C.
 * 
 * @param[in] t Estructura de tiempo `tm` con la fecha y hora a programar.
 * @return esp_err_t Resultado de la transacción I2C.
 */
static esp_err_t ds3231_set_time(const struct tm *t) {
    uint8_t d[8];
    d[0] = 0x00;
    d[1] = dec2bcd(t->tm_sec);
    d[2] = dec2bcd(t->tm_min);
    d[3] = dec2bcd(t->tm_hour);
    d[4] = dec2bcd(t->tm_wday + 1);
    d[5] = dec2bcd(t->tm_mday);
    d[6] = dec2bcd(t->tm_mon + 1);
    d[7] = dec2bcd(t->tm_year % 100);
    return i2c_master_write_to_device(I2C_NUM_0, DS3231_I2C_ADDR, d, sizeof(d), pdMS_TO_TICKS(1000));
}

/**
 * @brief Lee la fecha y hora almacenada en el RTC DS3231.
 * 
 * @param[out] t Estructura `tm` donde se cargará el tiempo leído.
 * @return esp_err_t Resultado de la transacción I2C.
 */
static esp_err_t ds3231_get_time(struct tm *t) {
    uint8_t reg = 0x00;
    uint8_t d[7];
    esp_err_t ret = i2c_master_write_read_device(I2C_NUM_0, DS3231_I2C_ADDR, &reg, 1, d, sizeof(d), pdMS_TO_TICKS(1000));
    if (ret != ESP_OK) return ret;
    t->tm_sec   = bcd2dec(d[0] & 0x7F);
    t->tm_min   = bcd2dec(d[1] & 0x7F);
    t->tm_hour  = bcd2dec(d[2] & 0x3F);
    t->tm_wday  = bcd2dec(d[3] & 0x07) - 1;
    t->tm_mday  = bcd2dec(d[4] & 0x3F);
    t->tm_mon   = bcd2dec(d[5] & 0x1F) - 1;
    t->tm_year  = bcd2dec(d[6]) + 100;
    return ESP_OK;
}

/**
 * @brief Lee la temperatura mediante el módulo SPI MAX6675 con reintentos.
 * 
 * @param[out] temp Puntero donde se almacenará el valor en °C.
 * @param[out] status Estado de la lectura (0 = OK, 1 = Termocupla abierta, 2 = Error de bus SPI).
 * @return esp_err_t 
 */
static esp_err_t max6675_read(float *temp, uint8_t *status) {
    uint16_t raw_data = 0;
    uint8_t dummy_tx[2] = {0xFF, 0xFF};
    bool valid = false;
    uint16_t raw = 0;

    for (int i = 0; i < 3 && !valid; i++) {
        spi_transaction_t t = {
            .length = 16,
            .tx_buffer = dummy_tx,
            .rx_buffer = &raw_data,
        };
        esp_err_t ret = spi_device_transmit(max6675_dev, &t);
        if (ret != ESP_OK) {
            *temp = 0.0f; *status = 2; return ret;
        }
        raw = __builtin_bswap16(raw_data);
        valid = !(raw == 0x0000 || raw == 0xFFFF || (raw & 0x8000));
        if (!valid) vTaskDelay(pdMS_TO_TICKS(220));
    }

    if (!valid) { *temp = 0.0f; *status = 2; return ESP_ERR_INVALID_RESPONSE; }

    if (raw & 0x04) { *temp = 0.0f; *status = 1; }
    else { *temp = (raw >> 3) * 0.25f; *status = 0; }
    return ESP_OK;
}

/* =======================================================================
 * LÓGICA DE CLASIFICACIÓN Y MODO AUTOMÁTICO
 * ======================================================================= */

/**
 * @brief Clasifica el porcentaje de humedad medida dentro de los rangos predefinidos.
 */
static hum_class_t classify_humidity(float h) {
    if (h < HUM_LIMIT_DRY) return HUM_DRY;
    if (h > HUM_LIMIT_WET) return HUM_WET;
    return HUM_IDEAL;
}

/**
 * @brief Devuelve la representación textual de la categoría de humedad.
 */
static const char *hum_class_text(hum_class_t c) {
    switch (c) {
        case HUM_DRY: return "MUY SECO (<10%)";
        case HUM_WET: return "MUY HUMEDO (>12%)";
        default:      return "IDEAL (10%-12%)";
    }
}

/**
 * @brief Determina los parámetros de temperatura y tiempo para el perfil de tostado automático.
 * 
 * @param[in]  c Clasificación de la humedad obtenida.
 * @param[out] temp_c Puntero a la temperatura asignada (°C).
 * @param[out] secs Puntero al tiempo total asignado (segundos).
 */
static void auto_params_for(hum_class_t c, float *temp_c, uint32_t *secs) {
    switch (c) {
        case HUM_DRY:
            *temp_c = AUTO_DRY_TEMP_C;
            *secs = AUTO_DRY_TIME_S;
            break;
        case HUM_WET:
            *temp_c = AUTO_WET_TEMP_C;
            *secs = AUTO_WET_TIME_S;
            break;
        default:
            *temp_c = AUTO_IDEAL_TEMP_C;
            *secs = AUTO_IDEAL_TIME_S;
            break;
    }
}

/* =======================================================================
 * MANEJO DE ARCHIVOS CSV EN TARJETA SD
 * ======================================================================= */

/**
 * @brief Escribe la cabecera CSV si el archivo especificado no existe o se encuentra vacío.
 */
static void sd_write_header_if_empty(const char *path, const char *header) {
    struct stat st;
    if (stat(path, &st) != 0 || st.st_size == 0) {
        FILE *f = fopen(path, "a");
        if (f) {
            fprintf(f, "%s\n", header);
            fclose(f);
        } else {
            ESP_LOGE(TAG, "No se pudo crear %s", path);
        }
    }
}

/**
 * @brief Prepara los archivos de registro y escanea el mayor ID de sesión registrado.
 * 
 * @return uint32_t El identificador más alto de sesión para mantener el consecutivo tras reinicios.
 */
static uint32_t sd_prepare_files(void) {
    sd_write_header_if_empty(SESSIONS_FILE, SESSIONS_HEADER);
    sd_write_header_if_empty(TEMPS_FILE, TEMPS_HEADER);

    uint32_t max_id = 0;
    FILE *f = fopen(SESSIONS_FILE, "r");
    if (f) {
        char line[160];
        while (fgets(line, sizeof(line), f)) {
            uint32_t v = (uint32_t)strtoul(line, NULL, 10);
            if (v > max_id) max_id = v;
        }
        fclose(f);
    }
    return max_id;
}

/**
 * @brief Formatea los datos de una nueva sesión de tostado en una línea CSV.
 */
static void format_session_csv(const sd_log_entry_t *e, char *out, size_t len) {
    char hum[12];
    if (e->humidity < 0.0f) {
        strlcpy(hum, "NA", sizeof(hum));
    } else {
        snprintf(hum, sizeof(hum), "%.1f", e->humidity);
    }
    snprintf(out, len, "%lu,%.10s,%s,%s,%s,%.1f,%lu,%.2f",
             (unsigned long)e->session_id,
             e->datetime,
             e->datetime + 11,
             hum,
             (e->mode == ROAST_MODE_AUTO) ? "AUTOMATICO" : "MANUAL",
             e->setpoint,
             (unsigned long)e->total_s,
             (float)e->total_s / 60.0f);
}

/**
 * @brief Formatea una muestra instantánea de temperatura en una línea CSV.
 */
static void format_sample_csv(const sd_log_entry_t *e, char *out, size_t len) {
    char temp[12];
    if (e->max_status != 0) {
        strlcpy(temp, "ERR", sizeof(temp));
    } else {
        snprintf(temp, sizeof(temp), "%.2f", e->temp);
    }
    snprintf(out, len, "%lu,%.10s,%s,%s",
             (unsigned long)e->session_id,
             e->datetime,
             e->datetime + 11,
             temp);
}

