/** @brief Período total del ciclo de pulso del motor en ms. */
#define MOTOR_PULSE_PERIOD_MS     1000
/** @brief Tiempo activo (ON) dentro de cada período en ms (a mayor tiempo, mayor velocidad). */
#define MOTOR_PULSE_ON_MS         200
/** @brief Paso de evaluación de la tarea de pulsado del motor en ms. */
#define MOTOR_PULSE_STEP_MS       10

