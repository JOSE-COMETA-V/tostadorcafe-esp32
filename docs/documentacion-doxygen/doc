/** @brief Flag de montaje correcto de la tarjeta SD. */
static bool sd_ok = false;
/** @brief Cadena global con la última fecha/hora leída del RTC. Protegida por `xTimeMutex`. */
static char shared_datetime[20] = "2026-09-29 19:07:00";

/** @brief Manejador del dispositivo SPI para el MAX6675. */
static spi_device_handle_t max6675_dev;

/** @brief Mutex de protección del estado global del proceso y variables de sensores. */
