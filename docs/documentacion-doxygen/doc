/* =======================================================================
 * TIPOS DE DATOS Y ESTRUCTURAS
 * ======================================================================= */

/**
 * @brief Estados del ciclo de vida del proceso de tostado.
 */
typedef enum {
    ROAST_IDLE = 0,    /**< Sistema en reposo, salidas apagadas. */
    ROAST_RUNNING,     /**< Proceso de tostado activo en ejecución. */
    ROAST_DONE         /**< Proceso finalizado exitosamente. */
} roast_state_t;

/**
 * @brief Modos de operación del tostador.
 */
typedef enum {
    ROAST_MODE_NONE = 0,  /**< Ningún modo seleccionado. */
    ROAST_MODE_MANUAL,    /**< Parámetros configurados manualmente por el usuario. */
    ROAST_MODE_AUTO       /**< Parámetros automáticos calculados según la humedad ambiental. */
} roast_mode_t;

/**
 * @brief Clasificación de la humedad ambiental para los perfiles de tostado.
 */
typedef enum {
    HUM_DRY = 0,  /**< Humedad baja (Grano muy seco). */
    HUM_IDEAL,    /**< Humedad óptima de almacenamiento. */
    HUM_WET       /**< Humedad elevada (Grano húmedo). */
} hum_class_t;

/**
 * @brief Estructura de paquete enviada por el puerto serie (CSV).
 */
typedef struct {
    uint64_t timestamp_ms;  /**< Marca de tiempo desde el arranque en ms. */
    char     datetime[20];  /**< Cadena con la fecha y hora formateada "YYYY-MM-DD HH:MM:SS". */
    float    temp_max6675;  /**< Lectura del sensor de temperatura en °C. */
    uint8_t  max_status;    /**< Estado de la termocupla (0 = OK, 1 = Abierta/Error, 2 = Fallo SPI). */
    float    humidity_dht;  /**< Lectura de humedad relativa del DHT11 en %. */
    uint8_t  dht_status;    /**< Estado de la lectura del DHT11 (0 = OK, 1 = Error/Timeout). */
} datalog_entry_t;

/**
 * @brief Tipo de evento destinado a la cola de escritura de la tarjeta SD.
 */
typedef enum {
    LOG_SESSION_START = 0,  /**< Registro de nuevo evento en sesiones.csv. */
    LOG_TEMP_SAMPLE         /**< Muestra periódica de temperatura en temperaturas.csv. */
} log_evt_type_t;

/**
 * @brief Estructura de datos enviada a la tarea de registro SD (`vTaskSDWriter`).
 */
typedef struct {
    log_evt_type_t type;         /**< Tipo de registro (Inicio de sesión o Muestra). */
    uint32_t       session_id;   /**< Identificador único consecutivo de la sesión. */
    char           datetime[20]; /**< Marca de tiempo del RTC. */
    
    /* Campos exclusivos para LOG_SESSION_START */
    float          humidity;     /**< Humedad inicial del ambiente (-1.0f si no es válida). */
    roast_mode_t   mode;         /**< Modo de operación empleado (Manual o Automático). */
    float          setpoint;     /**< Temperatura objetivo fijada en °C. */
    uint32_t       total_s;      /**< Duración total programada en segundos. */
    
    /* Campos exclusivos para LOG_TEMP_SAMPLE */
    float          temp;         /**< Temperatura instantánea registrada por el MAX6675. */
    uint8_t        max_status;   /**< Código de estado del MAX6675 (0 = OK). */
} sd_log_entry_t;

