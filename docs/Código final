static esp_err_t reply_json(httpd_req_t *req, const char *status, const char *json) {
    httpd_resp_set_status(req, status);
    httpd_resp_set_type(req, "application/json");
    return httpd_resp_send(req, json, HTTPD_RESP_USE_STRLEN);
}

static esp_err_t reply_error(httpd_req_t *req, const char *status, const char *msg) {
    char out[192];
    snprintf(out, sizeof(out), "{\"ok\":false,\"msg\":\"%s\"}", msg);
    return reply_json(req, status, out);
}

static esp_err_t root_get_handler(httpd_req_t *req) {
    httpd_resp_set_type(req, "text/html");
    return httpd_resp_send(req, html_page, HTTPD_RESP_USE_STRLEN);
}

static esp_err_t status_get_handler(httpd_req_t *req) {
    char json_response[512];
    char rtc_buf[20];

    get_datetime(rtc_buf, sizeof(rtc_buf));

    xSemaphoreTake(g_state_mutex, portMAX_DELAY);

    hum_class_t hc = classify_humidity(g_humidity_dht);
    const char *hum_state_str = hum_class_text(hc);

    // Vista previa de los parámetros del modo automático según la humedad actual
    float auto_t = 0.0f;
    uint32_t auto_s = 0;
    if (g_dht_valid_once) {
        auto_params_for(hc, &auto_t, &auto_s);
    }

    const char *state_str = "IDLE";
    if (g_roast_state == ROAST_RUNNING) state_str = "RUNNING";
    else if (g_roast_state == ROAST_DONE) state_str = "DONE";

    const char *mode_str = "NONE";
    if (g_roast_mode == ROAST_MODE_MANUAL) mode_str = "MANUAL";
    else if (g_roast_mode == ROAST_MODE_AUTO) mode_str = "AUTO";

    const char *phase_str = "-";
    if (g_roast_state == ROAST_RUNNING) {
        if (g_max_error) phase_str = "ERROR SENSOR";
        else if (!g_setpoint_reached) phase_str = "CALENTANDO";
        else phase_str = "MANTENIENDO";
    }

    snprintf(json_response, sizeof(json_response),
             "{\"temp_max\":%.2f,\"max_err\":%s,\"humidity\":%.1f,\"dht_err\":%s,\"hum_state\":\"%s\","
             "\"state\":\"%s\",\"mode\":\"%s\",\"phase\":\"%s\",\"setpoint\":%.1f,"
             "\"total_s\":%lu,\"remaining_s\":%lu,\"auto_temp\":%.1f,\"auto_min\":%.1f,\"rtc_time\":\"%s\"}",
             g_temp_max, g_max_error ? "true" : "false",
             g_humidity_dht, g_dht_error ? "true" : "false",
             hum_state_str,
             state_str, mode_str, phase_str, g_setpoint,
             (unsigned long)g_total_s, (unsigned long)g_remaining_s,
             auto_t, (float)auto_s / 60.0f,
             rtc_buf);
    xSemaphoreGive(g_state_mutex);

    httpd_resp_set_type(req, "application/json");
    return httpd_resp_send(req, json_response, HTTPD_RESP_USE_STRLEN);
}

// /api/start?mode=manual&temp=70&time=300   (time en segundos)
// /api/start?mode=auto
static esp_err_t start_handler(httpd_req_t *req) {
    char buf[96] = {0};
    char mode_str[12] = {0}, temp_str[16] = {0}, time_str[16] = {0};

    if (httpd_req_get_url_query_str(req, buf, sizeof(buf)) != ESP_OK ||
        httpd_query_key_value(buf, "mode", mode_str, sizeof(mode_str)) != ESP_OK) {
        return reply_error(req, "400 Bad Request", "Solicitud inválida");
    }

    roast_mode_t mode;
    float temp_c = 0.0f;
    uint32_t secs = 0;

    if (strcmp(mode_str, "manual") == 0) {
        mode = ROAST_MODE_MANUAL;
        if (httpd_query_key_value(buf, "temp", temp_str, sizeof(temp_str)) != ESP_OK ||
            httpd_query_key_value(buf, "time", time_str, sizeof(time_str)) != ESP_OK) {
            return reply_error(req, "400 Bad Request", "Faltan la temperatura o el tiempo");
        }
        temp_c = strtof(temp_str, NULL);
        long t = strtol(time_str, NULL, 10);
        if (temp_c < ROAST_TEMP_MIN_C || temp_c > ROAST_TEMP_MAX_C) {
            return reply_error(req, "400 Bad Request", "Temperatura fuera de rango (30 a 250 °C)");
        }
        if (t < ROAST_TIME_MIN_S || t > ROAST_TIME_MAX_S) {
            return reply_error(req, "400 Bad Request", "Tiempo fuera de rango (10 s a 120 min)");
        }
        secs = (uint32_t)t;
    } else if (strcmp(mode_str, "auto") == 0) {
        mode = ROAST_MODE_AUTO;
    } else {
        return reply_error(req, "400 Bad Request", "Modo desconocido");
    }

    const char *err = NULL;

    // Hora de inicio de la sesión (se lee antes de tomar g_state_mutex para no anidar mutex)
    char start_dt[20];
    get_datetime(start_dt, sizeof(start_dt));

    sd_log_entry_t ev = {0};
    bool session_started = false;

    xSemaphoreTake(g_state_mutex, portMAX_DELAY);
    if (g_roast_state == ROAST_RUNNING) {
        err = "Ya hay un proceso en marcha";
    } else if (g_max_error) {
        err = "Error en la termocupla MAX6675, no se puede iniciar";
    } else if (mode == ROAST_MODE_AUTO && !g_dht_valid_once) {
        err = "Aún no hay lectura válida de humedad";
    } else {
        if (mode == ROAST_MODE_AUTO) {
            // Los parámetros se fijan con la humedad medida en el momento de iniciar
            auto_params_for(classify_humidity(g_humidity_dht), &temp_c, &secs);
        }
        g_roast_mode = mode;
        g_setpoint = temp_c;
        g_total_s = secs;
        g_remaining_s = secs;
        g_setpoint_reached = false;
        g_session_id++;
        g_roast_state = ROAST_RUNNING;
        // Arranque: motor encendido y calefactor encendido hasta llegar a la temperatura
        set_outputs_locked(true, true);

        // Datos de la sesión que se guardarán en sesiones.csv
        ev.type = LOG_SESSION_START;
        ev.session_id = g_session_id;
        strlcpy(ev.datetime, start_dt, sizeof(ev.datetime));
        ev.humidity = g_dht_valid_once ? g_humidity_dht : -1.0f;   // -1 -> "NA" en el CSV
        ev.mode = mode;
        ev.setpoint = temp_c;
        ev.total_s = secs;
        session_started = true;
    }
    xSemaphoreGive(g_state_mutex);

    if (err) {
        return reply_error(req, "409 Conflict", err);
    }

    // Se envía a la tarea de la SD fuera del mutex para no bloquear el control
    if (sd_ok && session_started) {
        if (xQueueSend(xQueueSD, &ev, pdMS_TO_TICKS(100)) != pdTRUE) {
            ESP_LOGW(TAG, "Cola SD llena: no se registró el inicio de la sesión %lu",
                     (unsigned long)ev.session_id);
        }
    }

    ESP_LOGI(TAG, "Tostado iniciado (sesión %lu): %s, %.1f C, %lu s",
             (unsigned long)ev.session_id,
             (mode == ROAST_MODE_AUTO) ? "AUTO" : "MANUAL", temp_c, (unsigned long)secs);
    return reply_json(req, "200 OK", "{\"ok\":true}");
}

static esp_err_t stop_handler(httpd_req_t *req) {
    xSemaphoreTake(g_state_mutex, portMAX_DELAY);
    set_outputs_locked(false, false);
    g_roast_state = ROAST_IDLE;
    g_roast_mode = ROAST_MODE_NONE;
    g_remaining_s = 0;
    g_setpoint_reached = false;
    xSemaphoreGive(g_state_mutex);

    ESP_LOGI(TAG, "Tostado detenido por el usuario.");
    return reply_json(req, "200 OK", "{\"ok\":true}");
}

httpd_handle_t start_webserver(void) {
    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
    config.stack_size = 8192;
    httpd_handle_t server = NULL;

    if (httpd_start(&server, &config) == ESP_OK) {
        httpd_uri_t uri_root = { .uri = "/", .method = HTTP_GET, .handler = root_get_handler };
        httpd_uri_t uri_status = { .uri = "/api/status", .method = HTTP_GET, .handler = status_get_handler };
        httpd_uri_t uri_start = { .uri = "/api/start", .method = HTTP_GET, .handler = start_handler };
        httpd_uri_t uri_stop = { .uri = "/api/stop", .method = HTTP_GET, .handler = stop_handler };

        httpd_register_uri_handler(server, &uri_root);
        httpd_register_uri_handler(server, &uri_status);
        httpd_register_uri_handler(server, &uri_start);
        httpd_register_uri_handler(server, &uri_stop);
    }
    return server;
}

static void wifi_event_handler(void* arg, esp_event_base_t event_base, int32_t event_id, void* event_data) {
    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
        esp_wifi_connect();
    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
        esp_wifi_connect();
    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
        ip_event_got_ip_t* event = (ip_event_got_ip_t*) event_data;
        ESP_LOGI(TAG, "Conectado a Wi-Fi. Ingresa a: http://" IPSTR, IP2STR(&event->ip_info.ip));
    }
}

void wifi_init_sta(void) {
    ESP_ERROR_CHECK(esp_netif_init());
    ESP_ERROR_CHECK(esp_event_loop_create_default());
    esp_netif_create_default_wifi_sta();
    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, NULL);
    esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, NULL);

    wifi_config_t wifi_config = {
        .sta = {
            .ssid = WIFI_SSID,
            .password = WIFI_PASS,
            .threshold.authmode = WIFI_AUTH_WPA2_PSK,
        },
    };
    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
    ESP_ERROR_CHECK(esp_wifi_start());
}

